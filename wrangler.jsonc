{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoga-rise",
  "compatibility_date": "2026-08-28",
  "pages_build_output_dir": "./dist",
  "secrets": {
    "required": ["MAILER_API_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "yoga-rise-subscribers",
      "database_id": "bd4585a3-5ce8-4b5c-9c3c-e395608ce964"
    }
  ]
}
